# Copy to .env locally. Never commit real credentials.
# Production requires the canonical public HTTPS URL.
NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000
COMPANY_PHONE=
COMPANY_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
ADMIN_TOKEN=
# Optional: set only to actual trusted reverse-proxy CIDRs.
TRUSTED_PROXY_CIDRS=

# Required PostgreSQL connection, set privately in the server environment.
DATABASE_URL=
